{
  "_app_comment": [
    "-O disables jsii's __debug__-gated type-checking stubs. eoapi-cdk >=10.4.0",
    "generates stubs referencing aws-cdk-lib types (IKeyRef, IRoleRef) that no",
    "published aws-cdk-lib provides -- 2.267.0 is the latest and has neither -- so",
    "importing it raises AttributeError at synth. The stubs are dev-time checks",
    "only; the jsii runtime is unaffected. Drop -O once upstream regenerates its",
    "Python bindings (see eoapi-cdk#218).",
    "NOTE: -O also strips `assert` statements from infrastructure/app.py."
  ],
  "app": "python3 -O infrastructure/app.py",
  "watch": {
    "include": [
      "**"
    ],
    "exclude": [
      "README.md",
      "cdk*.json",
      "requirements*.txt",
      "source.bat",
      "**/*.pyc",
      "**/*.tmp",
      "**/__pycache__",
      "tests",
      "scripts",
      "*venv"
    ]
  },
  "context": {
    "@aws-cdk/aws-apigateway:usagePlanKeyOrderInsensitiveId": true,
    "@aws-cdk/core:stackRelativeExports": true,
    "@aws-cdk/aws-rds:lowercaseDbIdentifier": true,
    "@aws-cdk/aws-lambda:recognizeVersionProps": true,
    "@aws-cdk/aws-cloudfront:defaultSecurityPolicyTLSv1.2_2021": true,
    "@aws-cdk-containers/ecs-service-extensions:enableDefaultLogDriver": true,
    "@aws-cdk/core:target-partitions": [
      "aws",
      "aws-cn"
    ]
  }
}
